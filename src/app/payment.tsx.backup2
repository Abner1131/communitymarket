  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
```tsx
import { router } from "expo-router";
import { useState } from "react";
import {
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";

import { useCart } from "../context/CartContext";
import { useCheckout } from "../context/CheckoutContext";
import { useOrders } from "../context/OrderContext";

import {
  createOrderFromCheckout,
} from "../services/orderAdapter";

export default function PaymentScreen() {
  const {
    checkoutDraft,
    clearCheckoutDraft,
  } = useCheckout();

  const {
    registerServiceOrder,
  } = useOrders();

  const { clearCart } = useCart();

  const [
    showConfirmation,
    setShowConfirmation,
  ] = useState(false);

  const [
    isProcessing,
    setIsProcessing,
  ] = useState(false);

  if (!checkoutDraft) {
    return (
      <View style={styles.emptyContainer}>
        <Text style={styles.emptyEmoji}>
          🧾
        </Text>

        <Text style={styles.emptyTitle}>
          No Order to Review
        </Text>

        <Text style={styles.emptyText}>
          Your checkout information is no longer
          available. Please return to your cart and
          start checkout again.
        </Text>

        <Pressable
          style={styles.primaryButton}
          onPress={() =>
            router.replace("/")
          }
        >
          <Text style={styles.primaryButtonText}>
            Return to Marketplace
          </Text>
        </Pressable>
      </View>
    );
  }

  const {
    customerName,
    phone,
    address,
    customerLocation,
    items,
    pickupStops,
    vehicle,
    distanceKm,
    subtotal,
    deliveryFee,
    total,
  } = checkoutDraft;

  function handleCompleteOrder() {
    console.log(
      "COMPLETE ORDER BUTTON PRESSED"
    );

    setShowConfirmation(true);
  }

  async function handleConfirmOrder() {
    if (isProcessing) {
      return;
    }

    console.log(
      "CONFIRMING ORDER..."
    );

    setIsProcessing(true);

    try {
      /*
       * Create the canonical order through
       * the new CommunityMarket Order Service.
       *
       * The adapter:
       * - obtains the stable local customer ID
       * - converts checkout data to CreateOrderInput
       * - creates the canonical service order
       */
      const serviceOrder =
        await createOrderFromCheckout({
          customerName,
          phone,
          address,
          customerLocation,
          items,
          pickupStops,
          vehicle,
          distanceKm,
          subtotal,
          deliveryFee,
          total,
        });

      console.log(
        "SERVICE ORDER CREATED:",
        serviceOrder.id
      );

      /*
       * Register the canonical service order
       * inside the existing OrderContext.
       *
       * The bridge maps:
       * serviceOrder.id -> legacy orderId
       *
       * This allows the existing delivery and
       * dispatch system to continue working.
       */
      const newOrder =
        registerServiceOrder(
          serviceOrder
        );

      console.log(
        "ORDER REGISTERED:",
        newOrder.orderId
      );

      /*
       * Navigate first.
       *
       * We deliberately do NOT clear the checkout
       * draft before navigation because doing so can
       * cause this payment screen to re-render with
       * "No Order to Review".
       */
      router.replace({
        pathname: "/delivery",
        params: {
          orderId:
            newOrder.orderId,
        },
      });

      /*
       * Give React/navigation a moment to move away
       * from the payment screen before clearing the
       * checkout draft and cart.
       */
      setTimeout(() => {
        clearCheckoutDraft();
        clearCart();

        console.log(
          "CHECKOUT DRAFT CLEARED"
        );

        console.log(
          "CART CLEARED"
        );
      }, 300);
    } catch (error) {
      console.error(
        "ORDER CREATION ERROR:",
        error
      );

      setIsProcessing(false);
      setShowConfirmation(false);
    }
  }

  return (
    <View style={styles.container}>
      <ScrollView
        contentContainerStyle={
          styles.scrollContent
        }
      >
        {/* HEADER */}

        <View style={styles.header}>
          <Text style={styles.headerEmoji}>
            💳
          </Text>

          <View>
            <Text style={styles.headerTitle}>
              Payment
            </Text>

            <Text style={styles.headerSubtitle}>
              Review your order before completing
            </Text>
          </View>
        </View>

        {/* CUSTOMER */}

        <View style={styles.card}>
          <Text style={styles.sectionTitle}>
            👤 Customer Information
          </Text>

          <View style={styles.row}>
            <Text style={styles.label}>
              Name
            </Text>

            <Text style={styles.value}>
              {customerName}
            </Text>
          </View>

          <View style={styles.row}>
            <Text style={styles.label}>
              Phone
            </Text>

            <Text style={styles.value}>
              {phone}
            </Text>
          </View>

          <View style={styles.row}>
            <Text style={styles.label}>
              Address
            </Text>

            <Text style={styles.value}>
              {address}
            </Text>
          </View>
        </View>

        {/* DELIVERY */}

        <View style={styles.card}>
          <Text style={styles.sectionTitle}>
            🚚 Delivery Information
          </Text>

          <View style={styles.row}>
            <Text style={styles.label}>
              Vehicle
            </Text>

            <Text style={styles.value}>
              {vehicle === "bike"
                ? "🏍️ Bike"
                : "🛺 Keke"}
            </Text>
          </View>

          <View style={styles.row}>
            <Text style={styles.label}>
              Distance
            </Text>

            <Text style={styles.value}>
              {distanceKm.toFixed(1)} km
            </Text>
          </View>

          <View style={styles.row}>
            <Text style={styles.label}>
              Pickup Stops
            </Text>

            <Text style={styles.value}>
              {pickupStops.length}
            </Text>
          </View>

          <View style={styles.locationBox}>
            <Text style={styles.locationTitle}>
              📍 Delivery GPS
            </Text>

            <Text style={styles.locationText}>
              Latitude:{" "}
              {customerLocation.latitude.toFixed(
                6
              )}
            </Text>

            <Text style={styles.locationText}>
              Longitude:{" "}
              {customerLocation.longitude.toFixed(
                6
              )}
            </Text>
          </View>
        </View>

        {/* ITEMS */}

        <View style={styles.card}>
          <Text style={styles.sectionTitle}>
            🛒 Order Items
          </Text>

          {items.map((item) => {
            const itemTotal =
              item.unitPrice *
              item.quantity;

            return (
              <View
                key={item.productId}
                style={styles.itemRow}
              >
                <View
                  style={
                    styles.itemInformation
                  }
                >
                  <Text
                    style={styles.itemName}
                  >
                    {item.productName}
                  </Text>

                  <Text
                    style={styles.itemSeller}
                  >
                    {item.sellerName}
                  </Text>

                  <Text
                    style={styles.itemQuantity}
                  >
                    Qty: {item.quantity} × ₦
                    {item.unitPrice.toLocaleString()}
                  </Text>
                </View>

                <Text
                  style={styles.itemPrice}
                >
                  ₦
                  {itemTotal.toLocaleString()}
                </Text>
              </View>
            );
          })}
        </View>

        {/* PAYMENT METHOD */}

        <View style={styles.card}>
          <Text style={styles.sectionTitle}>
            💰 Payment Method
          </Text>

          <View
            style={styles.paymentMethod}
          >
            <Text style={styles.paymentIcon}>
              🧪
            </Text>

            <View
              style={
                styles.paymentInformation
              }
            >
              <Text
                style={
                  styles.paymentTitle
                }
              >
                Test Payment
              </Text>

              <Text
                style={
                  styles.paymentDescription
                }
              >
                Prototype payment mode for
                development testing.
              </Text>
            </View>

            <View
              style={styles.selectedBadge}
            >
              <Text
                style={
                  styles.selectedBadgeText
                }
              >
                SELECTED
              </Text>
            </View>
          </View>
        </View>

        {/* ORDER SUMMARY */}

        <View style={styles.summaryCard}>
          <Text style={styles.sectionTitle}>
            🧾 Order Summary
          </Text>

          <View style={styles.summaryRow}>
            <Text style={styles.summaryLabel}>
              Subtotal
            </Text>

            <Text style={styles.summaryValue}>
              ₦{subtotal.toLocaleString()}
            </Text>
          </View>

          <View style={styles.summaryRow}>
            <Text style={styles.summaryLabel}>
              Delivery Fee
            </Text>

            <Text style={styles.summaryValue}>
              ₦{deliveryFee.toLocaleString()}
            </Text>
          </View>

          <View style={styles.divider} />

          <View style={styles.totalRow}>
            <Text style={styles.totalLabel}>
              TOTAL
            </Text>

            <Text style={styles.totalValue}>
              ₦{total.toLocaleString()}
            </Text>
          </View>
        </View>

        {/* COMPLETE BUTTON */}

        <Pressable
          style={({ pressed }) => [
            styles.completeButton,
            pressed &&
              styles.completeButtonPressed,
          ]}
          onPress={handleCompleteOrder}
          disabled={isProcessing}
        >
          <Text
            style={
              styles.completeButtonText
            }
          >
            {isProcessing
              ? "Processing..."
              : "Complete Test Payment & Order"}
          </Text>
        </Pressable>

        <Text style={styles.prototypeNotice}>
          ⚠️ Prototype mode — no real payment is
          being processed.
        </Text>
      </ScrollView>

      {/* CONFIRMATION OVERLAY */}

      {showConfirmation && (
        <View
          style={styles.confirmOverlay}
        >
          <View style={styles.confirmCard}>
            <Text
              style={styles.confirmEmoji}
            >
              🛒
            </Text>

            <Text
              style={styles.confirmTitle}
            >
              Confirm Order
            </Text>

            <Text
              style={styles.confirmText}
            >
              You are about to place this order
              for:
            </Text>

            <Text
              style={styles.confirmAmount}
            >
              ₦{total.toLocaleString()}
            </Text>

            <Text
              style={styles.confirmText}
            >
              This is a prototype transaction.
              No real money will be charged.
            </Text>

            <View
              style={styles.confirmButtons}
            >
              <Pressable
                style={styles.cancelButton}
                onPress={() =>
                  setShowConfirmation(false)
                }
                disabled={isProcessing}
              >
                <Text
                  style={styles.cancelButtonText}
                >
                  Cancel
                </Text>
              </Pressable>

              <Pressable
                style={styles.confirmButton}
                onPress={handleConfirmOrder}
                disabled={isProcessing}
              >
                <Text
                  style={
                    styles.confirmButtonText
                  }
                >
                  {isProcessing
                    ? "Creating..."
                    : "Confirm Order"}
                </Text>
              </Pressable>
            </View>
          </View>
        </View>
      )}
    </View>
  );
}

