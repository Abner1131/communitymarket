rules_version = '2';

// CommunityMarket database rules.
//
// The app only touches four collections directly: products (read), orders
// (read own), users (own profile) and roleApplications (apply + read own).
// Everything else - wallets, ledger, withdrawals, top-ups, rewards, payments,
// sellers, riders, trips, settings - is read and written ONLY by the server
// (Vercel, admin key), which is not affected by these rules.
// Anything not listed below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Role comes from the login token (set by the server), never from a
    // database field the user could edit.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get("role", "") == "admin";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isShortText(value, max) {
      return value is string && value.size() <= max;
    }

    // Agreement to the policies: { version, at }, where "at" must be the
    // server's own time (the app sends serverTimestamp), so it can't be faked.
    function isAcceptance(value) {
      return value is map &&
             value.keys().hasOnly(["version", "at"]) &&
             isShortText(value.version, 20) &&
             value.at == request.time;
    }

    // ---------- users: your own profile ----------
    // Everyone signs up as a customer. Role and status are changed only by
    // the server when the admin approves an application.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
                       request.resource.data.keys().hasOnly([
                         "name", "phone", "email", "role", "status", "createdAt", "updatedAt",
                         "policiesAccepted"
                       ]) &&
                       (!("policiesAccepted" in request.resource.data) ||
                        isAcceptance(request.resource.data.policiesAccepted)) &&
                       request.resource.data.role == "customer" &&
                       request.resource.data.status == "active" &&
                       isShortText(request.resource.data.name, 100) &&
                       isShortText(request.resource.data.phone, 20);
      allow update: if isOwner(uid) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["name", "phone", "updatedAt", "policiesAccepted"]) &&
                       (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(["policiesAccepted"]) ||
                        isAcceptance(request.resource.data.policiesAccepted)) &&
                       isShortText(request.resource.data.get("name", ""), 100) &&
                       isShortText(request.resource.data.get("phone", ""), 20);
      allow delete: if false;
    }

    // ---------- applications to become a rider or seller ----------
    match /roleApplications/{applicationId} {
      allow create: if isSignedIn() &&
                       request.resource.data.keys().hasOnly([
                         "uid", "name", "email", "phone", "requestedRole", "vehicle",
                         "businessName", "businessAddress", "businessType", "note",
                         "status", "createdAt", "termsAccepted", "marketerCode"
                       ]) &&
                       // Optional marketer code: must be a real, switched-on code.
                       (request.resource.data.get("marketerCode", null) == null ||
                        (isShortText(request.resource.data.marketerCode, 10) &&
                         exists(/databases/$(database)/documents/marketerCodes/$(request.resource.data.marketerCode)) &&
                         get(/databases/$(database)/documents/marketerCodes/$(request.resource.data.marketerCode)).data.active == true)) &&
                       isAcceptance(request.resource.data.termsAccepted) &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.status == "pending" &&
                       request.resource.data.requestedRole in ["rider", "seller"] &&
                       request.resource.data.get("businessType", "shop")
                         in ["shop", "restaurant", "service"] &&
                       isShortText(request.resource.data.name, 100) &&
                       (request.resource.data.get("note", null) == null ||
                        isShortText(request.resource.data.note, 500));
      allow read: if isSignedIn() &&
                     (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false; // server only (admin approves/rejects)
    }

    // ---------- marketer codes: checked on the apply screen ----------
    // Anyone signed in may look up ONE code (to confirm it is valid);
    // listing all codes and every write is server only.
    match /marketerCodes/{code} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // ---------- products: public catalogue, server writes ----------
    // Sellers add and edit products through the server (seller dashboard),
    // which checks they own the shop. Hidden products are not public.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    // ---------- orders: the customer sees their own ----------
    // Sellers and riders see their orders through the server.
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---------- everything else: server only ----------
    // partnerWallets, ledger, withdrawals, topups, payments, rewardAccounts,
    // referralCodes, referrals, sellers, riders, trips, deliveries, settings ...
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
